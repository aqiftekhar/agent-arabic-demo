# --- LiveKit (required) ---
LIVEKIT_URL=ws://XX.X.X.XXX:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT / LLM providers (required) ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# --- STT / LLM config (optional, shown with defaults) ---
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=nova-3
STT_LANGUAGE=ar

# --- TTS provider (required) — you'll fill these in ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=

# --- FreePBX / SIP topology (required) ---
FREEPBX_HOST=X.X.X.XXX
SIP_DID_NUMBER=XXXXXXX

# --- SIP config (optional, shown with defaults) ---
SIP_TRANSFER_EXTENSION=80

# --- Agent identity (optional, shown with defaults) ---
AGENT_NAME=va-arabic

# --- Guardrails (optional, shown with defaults) ---
MAX_CALL_DURATION_SECONDS=600
MAX_LLM_TOKENS=120
DTMF_DEBOUNCE_SECONDS=0.3

# --- VAD tuning (optional, shown with defaults) ---
VAD_MIN_SPEECH_DURATION=0.1
VAD_MIN_SILENCE_DURATION=0.8
VAD_PREFIX_PADDING_DURATION=0.5
VAD_ACTIVATION_THRESHOLD=0.6

# --- Endpointing tuning (optional, shown with defaults) ---
MIN_ENDPOINTING_DELAY=1.2
MAX_ENDPOINTING_DELAY=6.0
